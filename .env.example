APP_NAME="AzerothCore"
APP_ENV=production
APP_SECRET=
ADMIN_MIN_GMLEVEL=3
ADMIN_REALM_ID=-1
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
LOG_LEVEL=info

HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TRUSTED_PROXIES=

DB_AUTH_HOST=host.docker.internal
DB_AUTH_PORT=3306
DB_AUTH_DATABASE=acore_auth
DB_AUTH_USERNAME=azweb_auth
DB_AUTH_PASSWORD=
DB_WEB_HOST=host.docker.internal
DB_WEB_PORT=3306
DB_WEB_DATABASE=azweb
DB_WEB_USERNAME=azweb
DB_WEB_PASSWORD=
DB_CHAR_HOST=host.docker.internal
DB_CHAR_PORT=3306
DB_CHAR_DATABASE=acore_characters
DB_CHAR_USERNAME=azweb_ro
DB_CHAR_PASSWORD=
DB_WORLD_DATABASE=acore_world

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

REALM_DEFAULT_ID=1
REALM_NAME="${APP_NAME}"
REALM_SOAP_URL=
REALM_SOAP_USERNAME=
REALM_SOAP_PASSWORD=

WOW_REALMLIST="set realmlist logon.example.com"
WOW_CLIENT_URL=
WOW_RATE_XP=x1
WOW_RATE_DROP=x1
WOW_RATE_GOLD=x1
WOW_RATE_REP=x1
WOW_AUCTION_SHARED=true
WOW_TOOLTIP_URL=https://wowgaming.altervista.org/aowow
WOW_REGISTRATION_ENABLED=true
WOW_COMMUNITY_PUBLIC=false
WOW_UNSTUCK_ENABLED=true
WOW_RENAME_ENABLED=true
WOW_CUSTOMIZE_ENABLED=true
WOW_UNSTUCK_COOLDOWN=PT3H
WOW_RENAME_COOLDOWN=P1Y
WOW_CUSTOMIZE_COOLDOWN=calendar_quarter

SITE_LOGO=
SITE_FAVICON=
SITE_DESCRIPTION=
